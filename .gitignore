# Public source allowlist. All other files and directories stay local by default.
/*
!/.gitignore
!/README.md
!/AGENTS.md
!/package.json
!/log-items.json
!/*.mjs
!/Start-Director.ps1
!/examples/
/examples/*
!/examples/*.example.*
!/test/
/test/*
!/test/*.test.mjs
!/hollow-harvest/
/hollow-harvest/*
!/hollow-harvest/.gitignore
!/hollow-harvest/README.md
!/hollow-harvest/*.mjs
!/hollow-harvest/Start-Prototype.ps1
!/hollow-harvest/test/
/hollow-harvest/test/*
!/hollow-harvest/test/*.test.mjs

# Defense in depth, including future nested files.
*.local.*
*.local
.env*
*secret*
*credential*
*token*
*.pem
*.key
*.pfx
*.p12
*.log
*.tmp
*.zip
*.tar*
*.jar
*.exe
*.dll
*.class
*.dat
*.mca
*.mcr
*.nbt
*.ldb
*.sqlite*
*.db
node_modules/
runtime*/
server*/
world*/
*world*/
backups/
backup*/
private-originals/
recovery*/
playerdata/
advancements/
stats/
region/
entities/
poi/
logs/
.codex/
.director-ipc/
*-stage/
staged-maps/
prepared-acquisition-pack/
dist/
build/
coverage/
__pycache__/
